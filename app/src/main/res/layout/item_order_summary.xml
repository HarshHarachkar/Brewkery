<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivOrderProduct"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:scaleType="centerCrop"
        android:contentDescription="Ordered product"
        android:background="@drawable/bg_category_unselected" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOrderProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Coffee Name"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvOrderCustomizations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Grande • Oat Milk • 50% Sugar"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="2" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvOrderQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="×1"
        android:textColor="@color/caramel"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>